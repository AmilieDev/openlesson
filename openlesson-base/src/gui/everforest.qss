QWidget#sidebar {
    background-color: palette(window);
}

QListWidget#sidebar_navigation {
    background-color: palette(window);
    border: none;
}

QListWidget#sidebar_navigation::item {
    padding: 5px 8px;
}

QTextBrowser#guide_page {
    border: none;
}

QLabel#config_editor_title {
    font-weight: 600;
}

QWidget#config_quick_edit {
    border-top: 1px solid palette(mid);
}